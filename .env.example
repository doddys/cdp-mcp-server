# ─────────────────────────────────────────────────────────────────────────────
# cdp-mcp — Environment Configuration
#
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
#
# Variable groups:
#   MCP_*          → MCP server behaviour (limits, retry, logging)
#   REGISTRY_*     → Registry backend selection and configuration
#   CM_*           → Single CM instance (EnvRegistry only)
#   IMPALA_*       → SQL backend for IcebergRegistry (original dvergari mode)
# ─────────────────────────────────────────────────────────────────────────────

# ── Registry Backend ──────────────────────────────────────────────────────────
# Choose: file | env | iceberg
REGISTRY_BACKEND=file

# Path to cm_instances.yaml (used only with REGISTRY_BACKEND=file)
REGISTRY_FILE_PATH=cm_instances.yaml


# ── Single CM instance (used only with REGISTRY_BACKEND=env) ─────────────────
# CM_HOST=cm.example.com
# CM_PORT=7183
# CM_USERNAME=admin
# CM_PASSWORD=changeme
# CM_ENVIRONMENT=default
# CM_USE_TLS=true
# CM_VERIFY_SSL=true
# CM_API_VERSION=v51
# CM_KERBEROS=false              # SPNEGO for downstream service endpoints only
                                # (NameNode/YARN/Spark/Oozie). CM uses Basic auth.
# In-process keytab acquisition (optional, unattended production): when
# CM_KERBEROS_KEYTAB is set, SPNEGO acquires a TGT from the keytab via gssapi
# instead of the default ccache, so no external kinit/renewer is needed.
# Requires CM_KERBEROS=true and CM_KERBEROS_PRINCIPAL.
# CM_KERBEROS_KEYTAB=/etc/cdp-mcp/mcp.keytab
# CM_KERBEROS_PRINCIPAL=mcp-svc@REALM
# Outbound proxy (all httpx clients): e.g. ALL_PROXY=socks5h://127.0.0.1:7890


# ── MCP Server ────────────────────────────────────────────────────────────────
# Transport: stdio (default — spawned by an MCP client over stdin/stdout),
# or streamable-http / sse to run as a long-lived network daemon (e.g. under
# systemd). When non-stdio, set MCP_HOST/MCP_PORT (bound by FastMCP at startup).
# Default bind is 127.0.0.1 (loopback) — DO NOT set 0.0.0.0 on a public VPS
# without auth in front.
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# Shared-secret bearer-token gate for the streamable-http/sse endpoint.
# When set, requests must send `Authorization: Bearer <MCP_AUTH_TOKEN>` or they
# get 401. Unset = no auth (loopback + SSH tunnel only). stdio is unaffected.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MCP_AUTH_TOKEN=
MCP_LOG_LEVEL=INFO
MCP_MAX_LOG_LINES=5000
MCP_MAX_LOG_RANGE_HOURS=48
MCP_MAX_RETRIES=3
MCP_RETRY_WAIT_SECONDS=2.0
MCP_MAX_CONCURRENT_REQUESTS=10
MCP_REQUESTS_PER_MINUTE=60
MCP_DEFAULT_METRIC_POINTS=100


# ── SQL Backend / IcebergRegistry (REGISTRY_BACKEND=iceberg only) ─────────────
# IMPALA_BACKEND=impala
# IMPALA_DATABASE=cdp_registry
# IMPALA_TABLE=cloudera_managers
# IMPALA_HOST=impala-coordinator.example.com
# IMPALA_AUTH_MECHANISM=LDAP
# IMPALA_USERNAME=svc-mcp-agent
# IMPALA_PASSWORD=changeme
# IMPALA_USE_SSL=true
# IMPALA_TIMEOUT_SECONDS=30
# IMPALA_POOL_SIZE=3
# IMPALA_REFRESH_INTERVAL_SECS=300
